# Copy to `.dev.vars` for `npx wrangler dev`, then fill in.
# `.dev.vars` is git-ignored — never commit real keys.
#
# In production these are Worker secrets, not a file:
#   npx wrangler secret put RESEND_API_KEY

# Required — create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Optional. Until davaodigital.com is verified in Resend, only the shared test
# sender can be used, and it can only deliver to the Resend account owner — so
# visitor confirmation emails stay switched off. Swap this for
#   Davao Digital <hello@davaodigital.com>
# once the domain is verified and confirmations start sending automatically.
RESEND_FROM=Davao Digital <onboarding@resend.dev>

# Optional — where leads land. Defaults to davaodigital@gmail.com.
LEAD_INBOX=davaodigital@gmail.com

# Optional — Google Apps Script web app URL that appends a row per enquiry.
# Setup steps are in DEPLOYMENT.md.
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=
